# ─── Local development (pnpm dev) ─────────────────────────────────────────────
# Points at the postgres service from docker-compose (port published on localhost)
DATABASE_URL=postgres://payload:change-me@127.0.0.1:5432/nhal

# ─── App ──────────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
PAYLOAD_SECRET=
PREVIEW_SECRET=
# Public URL of the site, no trailing slash. Inlined into the client bundle at build time,
# so rebuild the image after changing it.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# First admin user — created on boot only if the users table is empty.
# Remove these from the server .env after the first start.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=
PAYLOAD_ADMIN_NAME=Admin

# ─── Postgres (docker-compose) ────────────────────────────────────────────────
# Username must match "Username" in docker/pgadmin/servers.json
POSTGRES_USER=payload
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nhal
POSTGRES_PORT=5432

# ─── pgAdmin (optional, `--profile tools`) ────────────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
PGADMIN_PORT=5050

APP_PORT=3000
